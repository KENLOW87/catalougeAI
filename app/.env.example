OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1.5
VITE_API_URL=
# Only matters once deployed off localhost. Leave unset for local dev — the
# admin stays open with no login, same as always. Set it in Render's
# dashboard (never commit a real value) to require this password for
# everything except the read-only published-catalogue site.
ADMIN_PASSWORD=
# Set to 1 to put the catalogue assistant bot on the PUBLIC, no-login site —
# able to add/delete products and run AI photo edits there, for ANYONE with
# the URL, not only the admin. Leave unset/0 unless you specifically want
# that. PUBLIC_BOT_RATE_LIMIT_PER_HOUR bounds the paid-AI-call routes per
# visitor IP (default 20/hour) when this is on.
PUBLIC_CATALOGUE_EDIT=
PUBLIC_BOT_RATE_LIMIT_PER_HOUR=20

# Durable storage for PUBLISHED catalogues (app/server/supabase-store.mjs).
# Leave both unset for local development: publish then falls back to JSON files
# under app/data/published/, which is fine on a machine whose disk persists.
#
# Set BOTH in production. Render's free plan gives the container no persistent
# disk, so the file fallback loses every published catalogue on redeploy and on
# the 15-minute idle spin-down — that was the "catalogue keeps disappearing from
# the live site" bug. With these set, snapshots and their images live in
# Supabase instead and survive both.
#
# SUPABASE_URL      Project Settings > Data API > Project URL (https://<ref>.supabase.co)
# SERVICE_ROLE_KEY  Project Settings > API Keys > service_role (secret)
#
# The service_role key bypasses row-level security. It is a server-only secret:
# never commit a real value, never expose it to the browser, never log it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
