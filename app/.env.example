OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-1.5
VITE_API_URL=
# Only matters once deployed off localhost. Leave unset for local dev — the
# admin stays open with no login, same as always. Set it in Render's
# dashboard (never commit a real value) to require this password for
# everything except the read-only published-catalogue site.
ADMIN_PASSWORD=
# Set to 1 to put the catalogue assistant bot on the PUBLIC, no-login site —
# able to add/delete products and run AI photo edits there, for ANYONE with
# the URL, not only the admin. Leave unset/0 unless you specifically want
# that. PUBLIC_BOT_RATE_LIMIT_PER_HOUR bounds the paid-AI-call routes per
# visitor IP (default 20/hour) when this is on.
PUBLIC_CATALOGUE_EDIT=
PUBLIC_BOT_RATE_LIMIT_PER_HOUR=20
